---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Detalle del Artículo | Bazar Ache">
  <!-- Navbar -->
  <header class="panel-border-b">
    <div class="max-w-[1400px] mx-auto px-6 py-4 flex items-center justify-between gap-6 relative">
      <a href="/" class="type-display text-2xl md:text-3xl text-forest hover:opacity-80 transition-editorial shrink-0">
        Bazar Ache
      </a>
      <a href="/" class="type-label text-[0.65rem] text-charcoal/60 hover:text-forest transition-editorial">
        ← Volver al catálogo
      </a>
    </div>
  </header>

  <!-- Loading State -->
  <div id="loading-state" class="py-24 text-center">
    <div class="animate-pulse-dot inline-block w-3 h-3 rounded-full bg-forest mb-4"></div>
    <p class="type-label text-charcoal/40">Cargando artículo…</p>
  </div>

  <!-- Error State -->
  <div id="error-state" class="py-24 text-center hidden">
    <p class="type-display-sm text-2xl text-charcoal mb-4">Artículo no encontrado</p>
    <a href="/" class="type-label text-xs text-forest hover:opacity-80 underline underline-offset-4">Volver al catálogo</a>
  </div>

  <!-- Product Container -->
  <main id="product-container" class="hidden max-w-[1200px] mx-auto px-6 py-12 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-[1.2fr_1fr] lg:grid-cols-[1.5fr_1fr] gap-12 lg:gap-20">
      
      <!-- Left: Photo Gallery -->
      <div class="flex flex-col gap-4">
        <!-- Main Image -->
        <div class="aspect-4/3 md:aspect-square bg-cream-dark/20 rounded-2xl border border-charcoal/10 overflow-hidden relative group">
          <img id="main-image" src="" alt="Imagen principal" class="w-full h-full object-cover" />
          
          <div id="sold-badge-large" class="absolute inset-0 flex items-center justify-center hidden">
            <span class="type-label text-lg md:text-xl px-6 py-3 bg-charcoal/80 text-cream tracking-widest backdrop-blur-sm rounded-xl">
              Vendido
            </span>
          </div>
        </div>

        <!-- Thumbnails -->
        <div id="thumbnails-container" class="flex gap-3 overflow-x-auto pb-2 empty:hidden">
          <!-- Injected via JS -->
        </div>
      </div>

      <!-- Right: Details -->
      <div class="flex flex-col pt-2 md:pt-6">
        <div class="flex items-center gap-3 mb-6">
          <span id="badge-category" class="type-label text-[0.65rem] px-3 py-1.5 rounded-md bg-sage/40 text-charcoal/70">
            Categoría
          </span>
          <span id="badge-status" class="type-label text-[0.65rem] px-3 py-1.5 rounded-md">
            Estado
          </span>
        </div>

        <h1 id="product-title" class="type-display text-4xl md:text-5xl lg:text-6xl text-charcoal leading-tight mb-4">
          Cargando…
        </h1>

        <p id="product-price" class="type-mono text-2xl md:text-3xl text-forest mb-8">
          $0.00
        </p>

        <div class="w-12 h-[1px] bg-charcoal/10 mb-8"></div>

        <div class="prose prose-sm prose-p:text-charcoal/70 prose-p:leading-relaxed mb-10">
          <p id="product-description" class="whitespace-pre-line type-body">
            Cargando descripción...
          </p>
        </div>

        <div id="action-container" class="mt-auto pt-8">
          <!-- WhatsApp button injected here -->
        </div>
        
        <p class="type-label text-[0.6rem] text-charcoal/40 mt-6 text-center md:text-left">
          El pago y la entrega se coordinan directamente.
        </p>
      </div>

    </div>
  </main>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';
  const WHATSAPP_NUMBER = '526861868611';

  // DOM Elements
  const loadingState = document.getElementById('loading-state');
  const errorState = document.getElementById('error-state');
  const productContainer = document.getElementById('product-container');

  const mainImage = document.getElementById('main-image');
  const thumbnailsContainer = document.getElementById('thumbnails-container');
  const soldBadgeLarge = document.getElementById('sold-badge-large');

  const productTitle = document.getElementById('product-title');
  const productPrice = document.getElementById('product-price');
  const productDescription = document.getElementById('product-description');
  const badgeCategory = document.getElementById('badge-category');
  const badgeStatus = document.getElementById('badge-status');
  const actionContainer = document.getElementById('action-container');

  async function loadProduct() {
    const urlParams = new URLSearchParams(window.location.search);
    const id = urlParams.get('id');

    if (!id) {
      showError();
      return;
    }

    try {
      const { data: product, error } = await supabase
        .from('products')
        .select('*')
        .eq('id', id)
        .single();

      if (error || !product) {
        showError();
        return;
      }

      renderProduct(product);
    } catch (err) {
      showError();
    }
  }

  function showError() {
    loadingState.classList.add('hidden');
    errorState.classList.remove('hidden');
  }

  function renderProduct(product) {
    const isSold = product.estado === 'vendido';
    const priceFormatted = Number(product.precio).toLocaleString('es-MX', {
      minimumFractionDigits: 0, maximumFractionDigits: 2
    });

    // Info
    productTitle.textContent = product.nombre;
    productTitle.classList.toggle('line-through', isSold);
    productTitle.classList.toggle('opacity-50', isSold);

    productPrice.textContent = `$${priceFormatted} MXN`;
    productPrice.classList.toggle('line-through', isSold);
    productPrice.classList.toggle('opacity-50', isSold);

    productDescription.textContent = product.descripcion || 'Sin descripción adicional.';
    badgeCategory.textContent = product.categoria;

    badgeStatus.textContent = isSold ? 'Vendido' : 'Disponible';
    badgeStatus.className = `type-label text-[0.65rem] px-3 py-1.5 rounded-md shadow-sm ${isSold ? 'badge-vendido' : 'badge-disponible'}`;

    // Action Button
    if (isSold) {
      soldBadgeLarge.classList.remove('hidden');
      mainImage.classList.add('grayscale', 'opacity-80');
      actionContainer.innerHTML = `
        <button disabled class="w-full py-4 rounded-xl bg-charcoal/5 text-charcoal/40 type-label text-sm cursor-not-allowed">
          Artículo no disponible
        </button>
      `;
    } else {
      const msg = encodeURIComponent(`¡Hola! Me interesa el artículo: ${product.nombre} por $${priceFormatted} MXN del catálogo de Bazar Ache.`);
      actionContainer.innerHTML = `
        <a href="https://wa.me/${WHATSAPP_NUMBER}?text=${msg}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-3 w-full py-4 rounded-xl bg-forest text-cream type-label text-sm shadow-xl hover:bg-charcoal hover:-translate-y-1 transition-editorial group">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Comprar por WhatsApp
        </a>
      `;
    }

    // Gallery
    const allImages = [];
    if (product.imagen_url) allImages.push(product.imagen_url);
    if (product.galeria && product.galeria.length > 0) {
      allImages.push(...product.galeria);
    }

    if (allImages.length > 0) {
      mainImage.src = allImages[0];

      if (allImages.length > 1) {
        thumbnailsContainer.innerHTML = allImages.map((img, idx) => `
          <button type="button" class="thumb-btn w-20 h-20 shrink-0 rounded-lg overflow-hidden border-2 transition-all ${idx === 0 ? 'border-forest' : 'border-transparent opacity-60 hover:opacity-100'}" data-src="${img}">
            <img src="${img}" class="w-full h-full object-cover" />
          </button>
        `).join('');

        // Thumbnail click handlers
        const thumbBtns = thumbnailsContainer.querySelectorAll('.thumb-btn');
        thumbBtns.forEach(btn => {
          btn.addEventListener('click', (e) => {
            const src = e.currentTarget.dataset.src;
            mainImage.src = src;
            
            // Update active state
            thumbBtns.forEach(b => {
              b.classList.remove('border-forest');
              b.classList.add('border-transparent', 'opacity-60');
            });
            e.currentTarget.classList.add('border-forest');
            e.currentTarget.classList.remove('border-transparent', 'opacity-60');
          });
        });
      }
    } else {
      mainImage.src = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%"><rect fill="%23E2E8DC" width="100%" height="100%"/><text fill="%231C201D" x="50%" y="50%" font-family="sans-serif" font-size="14" text-anchor="middle" opacity="0.4">Sin imagen</text></svg>';
    }

    // Show container
    loadingState.classList.add('hidden');
    productContainer.classList.remove('hidden');
  }

  // Init
  loadProduct();
</script>
