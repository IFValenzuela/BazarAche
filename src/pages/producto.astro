---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Detalle del Artículo | Bazar Ache">
  <!-- Navbar -->
  <header class="sticky top-0 z-50 bg-cream/95 backdrop-blur-sm panel-border-b">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 sm:h-16 md:h-20 flex items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2.5 sm:gap-3 group shrink-0">
        <img 
          src="/favicon.png" 
          alt="Bazar Ache Logo" 
          class="h-7 w-auto sm:h-8.5 object-contain group-hover:scale-105 transition-all"
        />
        <span class="type-display text-2xl sm:text-3xl text-charcoal hover:opacity-80 transition-editorial">
          Bazar Ache
        </span>
      </a>
      <a href="/" class="text-[11px] sm:text-xs font-mono uppercase tracking-wider text-charcoal/50 hover:text-charcoal transition-editorial shrink-0">
        ← <span class="hidden sm:inline">Volver al </span>catálogo
      </a>
    </div>
  </header>

  <!-- Loading State -->
  <div id="loading-state" class="py-24 text-center">
    <p class="type-label text-charcoal/40">Cargando artículo…</p>
  </div>

  <!-- Error State -->
  <div id="error-state" class="py-24 text-center hidden px-6">
    <p class="type-display-sm text-2xl text-charcoal mb-4">Artículo no encontrado</p>
    <a href="/" class="type-label text-xs text-ochre hover:opacity-80 underline underline-offset-4">Volver al catálogo</a>
  </div>

  <!-- Product Container -->
  <main id="product-container" class="hidden max-w-[1200px] mx-auto px-4 sm:px-6 py-6 sm:py-12 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-[1.2fr_1fr] lg:grid-cols-[1.5fr_1fr] gap-8 md:gap-12 lg:gap-20">
      
      <!-- Left: Photo Gallery -->
      <div class="flex flex-col gap-3 sm:gap-4">
        <!-- Main Image -->
        <div class="aspect-4/3 md:aspect-square bg-cream-dark rounded-2xl border border-card-border overflow-hidden relative group select-none">
          <img id="main-image" src="" alt="Imagen principal" class="w-full h-full object-cover transition-all duration-300" />
          
          <!-- Prev Button -->
          <button 
            id="prev-image-btn" 
            type="button"
            aria-label="Foto anterior"
            class="hidden absolute left-2 sm:left-3 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/90 hover:bg-white text-charcoal shadow-md backdrop-blur-sm flex items-center justify-center transition-all opacity-85 hover:opacity-100 hover:scale-105 active:scale-95 z-10 cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5 -translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <!-- Next Button -->
          <button 
            id="next-image-btn" 
            type="button"
            aria-label="Siguiente foto"
            class="hidden absolute right-2 sm:right-3 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/90 hover:bg-white text-charcoal shadow-md backdrop-blur-sm flex items-center justify-center transition-all opacity-85 hover:opacity-100 hover:scale-105 active:scale-95 z-10 cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5 translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <!-- Image Counter Pill -->
          <div id="image-counter" class="hidden absolute bottom-3 right-3 px-2.5 py-1 rounded-md bg-charcoal/75 backdrop-blur-sm text-cream text-[11px] font-mono tracking-wider z-10">
            1 / 1
          </div>

          <div id="sold-badge-large" class="absolute inset-0 flex items-center justify-center hidden z-20">
            <span class="type-label text-base sm:text-lg md:text-xl px-5 py-2.5 bg-charcoal/80 text-cream tracking-widest backdrop-blur-sm rounded-xl">
              Vendido
            </span>
          </div>
        </div>

        <!-- Thumbnails -->
        <div id="thumbnails-container" class="flex gap-2.5 sm:gap-3 overflow-x-auto pb-2 empty:hidden" style="scrollbar-width: none; -ms-overflow-style: none;">
          <!-- Injected via JS -->
        </div>
      </div>

      <!-- Right: Details -->
      <div class="flex flex-col pt-0 md:pt-4">
        <div class="flex items-center gap-2.5 mb-4 sm:mb-6">
          <span id="badge-category" class="text-[10px] font-mono tracking-widest uppercase px-2.5 py-1 rounded-md bg-white border border-card-border text-charcoal">
            Categoría
          </span>
          <span id="badge-status" class="hidden type-label text-[0.65rem] px-2.5 py-1 rounded-md badge-vendido">
            Vendido
          </span>
        </div>

        <h1 id="product-title" class="type-display text-2xl sm:text-4xl md:text-5xl text-charcoal leading-snug mb-3">
          Cargando…
        </h1>

        <p id="product-price" class="type-mono text-xl sm:text-2xl md:text-3xl font-bold text-charcoal mb-6">
          $0.00
        </p>

        <div class="w-12 h-[1px] bg-card-border mb-6"></div>

        <div class="prose prose-sm prose-p:text-charcoal/70 prose-p:leading-relaxed mb-8">
          <p id="product-description" class="whitespace-pre-line text-xs sm:text-sm">
            Cargando descripción...
          </p>
        </div>

        <div id="action-container" class="mt-auto pt-4 sm:pt-6">
          <!-- WhatsApp button injected here -->
        </div>
        
        <p class="type-label text-[0.6rem] text-charcoal/40 mt-4 text-center md:text-left">
          El pago y la entrega se coordinan directamente.
        </p>
      </div>

    </div>
  </main>

  <!-- ═══════════════════════════════════════════════════════
       COMPACT BRANDED FOOTER
       ═══════════════════════════════════════════════════════ -->
  <footer class="mt-12 sm:mt-16 bg-hero-bg text-cream/90 border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 flex flex-col md:flex-row items-center justify-between gap-4 sm:gap-6">
      
      <!-- Brand & Location -->
      <div class="flex items-center gap-3">
        <a href="/" class="type-display text-xl text-cream hover:text-ochre transition-editorial">
          Bazar Ache
        </a>
        <span class="text-white/20">·</span>
        <span class="text-xs font-mono text-warm-gold">Mexicali, B.C.</span>
      </div>

      <!-- Navigation Links -->
      <nav class="flex items-center gap-6 sm:gap-8 text-xs font-mono tracking-wider uppercase text-cream/60">
        <a href="/#catalogo" class="hover:text-cream transition-editorial">Catálogo</a>
        <a href="/#como-funciona" class="hover:text-cream transition-editorial">Cómo Funciona</a>
      </nav>

      <!-- Phone, WhatsApp & Copyright -->
      <div class="flex flex-col sm:flex-row items-center justify-center md:justify-end gap-3 sm:gap-5 text-xs font-mono text-cream/60 text-center">
        <a
          href="https://wa.me/526861868611"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-cream/80 hover:text-ochre transition-editorial"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 fill-current text-ochre" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>+52 (686) 186-8611</span>
        </a>
        <span class="text-white/20 hidden sm:inline">·</span>
        <span>© {new Date().getFullYear()} Bazar Ache</span>
      </div>

    </div>
  </footer>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase';
  const WHATSAPP_NUMBER = '526861868611';

  // DOM Elements
  const loadingState = document.getElementById('loading-state');
  const errorState = document.getElementById('error-state');
  const productContainer = document.getElementById('product-container');

  const mainImage = document.getElementById('main-image');
  const prevImageBtn = document.getElementById('prev-image-btn');
  const nextImageBtn = document.getElementById('next-image-btn');
  const imageCounter = document.getElementById('image-counter');
  const thumbnailsContainer = document.getElementById('thumbnails-container');
  const soldBadgeLarge = document.getElementById('sold-badge-large');

  const productTitle = document.getElementById('product-title');
  const productPrice = document.getElementById('product-price');
  const productDescription = document.getElementById('product-description');
  const badgeCategory = document.getElementById('badge-category');
  const badgeStatus = document.getElementById('badge-status');
  const actionContainer = document.getElementById('action-container');

  // Gallery state
  let galleryImages = [];
  let currentImageIndex = 0;

  async function loadProduct() {
    const urlParams = new URLSearchParams(window.location.search);
    const id = urlParams.get('id');

    if (!id) {
      showError();
      return;
    }

    try {
      const { data: product, error } = await supabase
        .from('products')
        .select('*')
        .eq('id', id)
        .single();

      if (error || !product) {
        showError();
        return;
      }

      renderProduct(product);
    } catch (err) {
      showError();
    }
  }

  function showError() {
    loadingState.classList.add('hidden');
    errorState.classList.remove('hidden');
  }

  function setActiveImage(index) {
    if (galleryImages.length === 0) return;
    currentImageIndex = (index + galleryImages.length) % galleryImages.length;
    mainImage.src = galleryImages[currentImageIndex];
    imageCounter.textContent = `${currentImageIndex + 1} / ${galleryImages.length}`;

    // Update thumbnail highlights
    const thumbBtns = thumbnailsContainer.querySelectorAll('.thumb-btn');
    thumbBtns.forEach((btn, idx) => {
      if (idx === currentImageIndex) {
        btn.classList.add('border-ochre');
        btn.classList.remove('border-transparent', 'opacity-60');
      } else {
        btn.classList.remove('border-ochre');
        btn.classList.add('border-transparent', 'opacity-60');
      }
    });
  }

  function renderProduct(product) {
    const isSold = product.estado === 'vendido';
    const priceFormatted = Number(product.precio).toLocaleString('es-MX', {
      minimumFractionDigits: 0, maximumFractionDigits: 2
    });

    // Info
    productTitle.textContent = product.nombre;
    productTitle.classList.toggle('line-through', isSold);
    productTitle.classList.toggle('opacity-50', isSold);

    productPrice.textContent = `$${priceFormatted} MXN`;
    productPrice.classList.toggle('line-through', isSold);
    productPrice.classList.toggle('opacity-50', isSold);

    productDescription.textContent = product.descripcion || 'Sin descripción adicional.';
    badgeCategory.textContent = product.categoria;

    if (isSold) {
      badgeStatus.textContent = 'Vendido';
      badgeStatus.className = 'type-label text-[0.65rem] px-2.5 py-1 rounded-md shadow-sm badge-vendido inline-block';
      badgeStatus.classList.remove('hidden');
    } else {
      badgeStatus.classList.add('hidden');
    }

    // Action Button
    if (isSold) {
      soldBadgeLarge.classList.remove('hidden');
      mainImage.classList.add('grayscale', 'opacity-80');
      actionContainer.innerHTML = `
        <button disabled class="w-full py-4 rounded-xl bg-charcoal/5 text-charcoal/40 type-label text-sm cursor-not-allowed">
          Artículo no disponible
        </button>
      `;
    } else {
      const msg = encodeURIComponent(`¡Hola! Me interesa el artículo: ${product.nombre} por $${priceFormatted} MXN del catálogo de Bazar Ache.`);
      actionContainer.innerHTML = `
        <a href="https://wa.me/${WHATSAPP_NUMBER}?text=${msg}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-3 w-full py-4 rounded-xl bg-forest text-cream type-label text-sm shadow-xl hover:bg-forest-hover hover:-translate-y-1 transition-editorial group">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Comprar por WhatsApp
        </a>
      `;
    }

    // Setup Gallery
    galleryImages = [];
    if (product.imagen_url) galleryImages.push(product.imagen_url);
    if (product.galeria && product.galeria.length > 0) {
      galleryImages.push(...product.galeria);
    }

    if (galleryImages.length > 0) {
      setActiveImage(0);

      if (galleryImages.length > 1) {
        // Show navigation controls
        prevImageBtn.classList.remove('hidden');
        nextImageBtn.classList.remove('hidden');
        imageCounter.classList.remove('hidden');

        // Render thumbnails
        thumbnailsContainer.innerHTML = galleryImages.map((img, idx) => `
          <button type="button" class="thumb-btn w-20 h-20 shrink-0 rounded-lg overflow-hidden border-2 transition-all cursor-pointer ${idx === 0 ? 'border-ochre' : 'border-transparent opacity-60 hover:opacity-100'}" data-index="${idx}">
            <img src="${img}" class="w-full h-full object-cover" />
          </button>
        `).join('');

        // Thumbnail click handlers
        const thumbBtns = thumbnailsContainer.querySelectorAll('.thumb-btn');
        thumbBtns.forEach(btn => {
          btn.addEventListener('click', (e) => {
            const index = parseInt(e.currentTarget.dataset.index, 10);
            setActiveImage(index);
          });
        });

        // Arrow button listeners
        prevImageBtn.onclick = () => setActiveImage(currentImageIndex - 1);
        nextImageBtn.onclick = () => setActiveImage(currentImageIndex + 1);

        // Keyboard arrow listeners
        window.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') setActiveImage(currentImageIndex - 1);
          if (e.key === 'ArrowRight') setActiveImage(currentImageIndex + 1);
        });
      }
    } else {
      mainImage.src = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%"><rect fill="%23EAE8E3" width="100%" height="100%"/><text fill="%231C201D" x="50%" y="50%" font-family="sans-serif" font-size="14" text-anchor="middle" opacity="0.4">Sin imagen</text></svg>';
    }

    // Show container
    loadingState.classList.add('hidden');
    productContainer.classList.remove('hidden');
  }

  // Init
  loadProduct();
</script>
