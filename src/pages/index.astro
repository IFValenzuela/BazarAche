---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Bazar Ache — Catálogo" description="Encuentra artículos únicos y de segunda mano en Mexicali. Compra fácil por WhatsApp.">

  <!-- ═══════════════════════════════════════════════════════
       HEADER
       ═══════════════════════════════════════════════════════ -->
  <header class="panel-border-b">
    <div class="max-w-[1400px] mx-auto px-6 py-4 flex items-center justify-between gap-6 relative">
      <!-- Brand -->
      <a href="/" class="type-display text-2xl md:text-3xl text-forest hover:opacity-80 transition-editorial shrink-0">
        Bazar Ache
      </a>

      <!-- Center Nav -->
      <nav class="hidden md:flex items-center gap-6 absolute left-1/2 -translate-x-1/2">
        <a href="#catalogo" class="type-label text-[0.65rem] text-charcoal/60 hover:text-forest transition-editorial">Catálogo</a>
        <a href="#como-funciona" class="type-label text-[0.65rem] text-charcoal/60 hover:text-forest transition-editorial">Cómo Funciona</a>
      </nav>

      <!-- WhatsApp (outline style) -->
      <a
        href="https://wa.me/526861868611"
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 type-label text-xs flex items-center gap-2 px-5 py-2.5 border border-forest/30 rounded-full text-forest hover:bg-forest hover:text-cream transition-editorial"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp
      </a>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════════════════
       HERO / INTRO
       ═══════════════════════════════════════════════════════ -->
  <section class="relative">
    <!-- Background Image -->
    <div 
      class="absolute inset-0 z-0 bg-cover bg-center"
      style="background-image: url('/BazarAche.png');"
    ></div>
    <!-- Very subtle dark overlay just for pure contrast, no milky fade -->
    <div class="absolute inset-0 z-0 bg-charcoal/20"></div>
    
    <!-- Content -->
    <div class="relative z-10 max-w-[1400px] mx-auto px-6 pt-16 pb-10 md:pt-24 md:pb-14">
      <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr] gap-10 items-end">
        <!-- Left: Eyebrow + Headline -->
        <div>
          <p class="type-mono text-xs text-cream/70 tracking-widest uppercase mb-4 drop-shadow-md">Catálogo de Segunda Mano</p>
          <h1 class="type-display text-5xl md:text-7xl lg:text-8xl text-cream leading-[0.95] drop-shadow-lg">
            Artículos<br/>
            <span class="text-sage italic">únicos</span><br/>
            en Mexicali
          </h1>
        </div>
        <!-- Right: Anchored info box -->
        <div id="como-funciona" class="hidden md:block bg-charcoal/40 backdrop-blur-md border border-cream/10 rounded-2xl p-7 shadow-2xl">
          <p class="type-label text-cream/90 mb-4 drop-shadow-sm">Cómo funciona</p>
          <ol class="text-sm text-cream/80 leading-relaxed space-y-2">
            <li class="flex gap-2">
              <span class="type-mono text-xs text-sage shrink-0 drop-shadow-sm">01</span>
              Explora el catálogo y elige lo que te guste.
            </li>
            <li class="flex gap-2">
              <span class="type-mono text-xs text-sage shrink-0 drop-shadow-sm">02</span>
              Haz clic en "Comprar por WhatsApp".
            </li>
            <li class="flex gap-2">
              <span class="type-mono text-xs text-sage shrink-0 drop-shadow-sm">03</span>
              Coordina el pago y entrega directamente.
            </li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       FILTER BAR
       ═══════════════════════════════════════════════════════ -->
  <section id="catalogo" class="sticky top-0 z-40 bg-cream/95 backdrop-blur-md py-4">
    <div class="max-w-[1400px] mx-auto px-6">
      <div class="flex items-center gap-4 bg-white/50 border border-charcoal/10 rounded-2xl px-5 py-3 overflow-x-auto shadow-sm">
        <span class="type-label text-[0.65rem] text-charcoal/50 shrink-0">Filtrar:</span>
        <div id="filter-bar" class="flex items-center gap-2">
          <!-- Filters injected by JS -->
        </div>
        <div class="ml-auto shrink-0 type-mono text-xs text-charcoal/40" id="product-count"></div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       PRODUCT GRID
       ═══════════════════════════════════════════════════════ -->
  <main class="max-w-[1400px] mx-auto px-6 py-12">
    <!-- Loading state -->
    <div id="catalog-loading" class="py-20 text-center">
      <p class="type-label text-charcoal/40 tracking-widest">Cargando catálogo…</p>
    </div>

    <!-- Empty state -->
    <div id="catalog-empty" class="py-20 text-center hidden">
      <p class="type-display text-2xl text-charcoal/30 italic">No hay artículos disponibles</p>
      <p class="text-sm text-charcoal/40 mt-3">Vuelve pronto — actualizamos el catálogo constantemente.</p>
    </div>

    <!-- Product grid -->
    <div id="catalog-grid" class="hidden">
      <!-- Products injected by JS -->
    </div>
  </main>

  <!-- ═══════════════════════════════════════════════════════
       FOOTER
       ═══════════════════════════════════════════════════════ -->
  <footer class="panel-border-t mt-20">
    <div class="max-w-[1400px] mx-auto px-6 py-10 grid grid-cols-1 md:grid-cols-[1fr_1fr_1fr] gap-8">
      <div>
        <p class="type-display text-xl text-forest">Bazar Ache</p>
        <p class="text-xs text-charcoal/50 mt-1">Mexicali, Baja California</p>
      </div>
      <div>
        <p class="type-label text-xs text-charcoal/40 mb-2">Contacto</p>
        <a
          href="https://wa.me/526861868611"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-forest hover:text-charcoal transition-editorial"
        >
          WhatsApp: +52 686 186 8611
        </a>
      </div>
      <div class="md:text-right">
        <p class="type-mono text-xs text-charcoal/30">
          © {new Date().getFullYear()} Bazar Ache
        </p>
        <p class="text-xs text-charcoal/30 mt-1">Todos los derechos reservados</p>
      </div>
    </div>
  </footer>

</BaseLayout>

<!-- ═══════════════════════════════════════════════════════
     CLIENT-SIDE JAVASCRIPT
     ═══════════════════════════════════════════════════════ -->
<script>
  import { supabase } from '../lib/supabase.mjs';

  const WHATSAPP_NUMBER = '526861868611'; // Replace with actual business number

  // ── State ────────────────────────────────────────────────
  let allProducts = [];
  let activeFilter = 'Todos';

  // ── DOM Refs ─────────────────────────────────────────────
  const loadingEl = document.getElementById('catalog-loading');
  const emptyEl = document.getElementById('catalog-empty');
  const gridEl = document.getElementById('catalog-grid');
  const filterBar = document.getElementById('filter-bar');
  const countEl = document.getElementById('product-count');

  // ── Fetch Products ───────────────────────────────────────
  async function fetchProducts() {
    const { data, error } = await supabase
      .from('products')
      .select('*')
      .order('created_at', { ascending: false });

    if (error) {
      console.error('Error fetching products:', error);
      loadingEl.classList.add('hidden');
      emptyEl.classList.remove('hidden');
      return;
    }

    allProducts = data || [];
    loadingEl.classList.add('hidden');

    if (allProducts.length === 0) {
      emptyEl.classList.remove('hidden');
      return;
    }

    buildFilters();
    renderProducts();
    gridEl.classList.remove('hidden');
  }

  // ── Build Filter Buttons ─────────────────────────────────
  function buildFilters() {
    const categories = ['Todos', ...new Set(allProducts.map(p => p.categoria))];

    filterBar.innerHTML = categories.map(cat => `
      <button
        data-category="${cat}"
        class="filter-btn type-label text-xs px-5 py-2 rounded-full transition-editorial whitespace-nowrap
               ${cat === activeFilter
                 ? 'bg-forest text-cream shadow-md'
                 : 'bg-white text-charcoal/70 hover:bg-sage/40 hover:text-forest border border-charcoal/10'
               }"
      >
        ${cat}
      </button>
    `).join('');

    // Attach listeners
    filterBar.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        activeFilter = btn.dataset.category;
        buildFilters(); // Re-render to update active state
        renderProducts();
      });
    });
  }

  // ── Render Products ──────────────────────────────────────
  function renderProducts() {
    const filtered = activeFilter === 'Todos'
      ? allProducts
      : allProducts.filter(p => p.categoria === activeFilter);

    countEl.textContent = `${filtered.length} artículo${filtered.length !== 1 ? 's' : ''}`;

    if (filtered.length === 0) {
      gridEl.innerHTML = `
        <div class="py-16 text-center col-span-full">
          <p class="type-display-sm text-xl text-charcoal/30 italic">
            Sin resultados en "${activeFilter}"
          </p>
        </div>
      `;
      return;
    }

    gridEl.innerHTML = `
      <div class="catalog-grid-layout">
        ${filtered.map((product, idx) => renderProductCard(product, idx)).join('')}
      </div>
    `;
  }

  // ── Single Product Card ──────────────────────────────────
  function renderProductCard(product, index) {
    const isSold = product.estado === 'vendido';
    const priceFormatted = Number(product.precio).toLocaleString('es-MX', {
      minimumFractionDigits: 0,
      maximumFractionDigits: 2,
    });

    const whatsappMsg = encodeURIComponent(
      `¡Hola! Me interesa el artículo: ${product.nombre} por $${priceFormatted} MXN del catálogo de Bazar Ache.`
    );
    const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${whatsappMsg}`;


    return `
      <article class="catalog-card ${isSold ? 'catalog-card--sold' : ''} group">
        <!-- Image (Link to Detail Page) -->
        <a href="/producto?id=${product.id}" class="catalog-card__image block">
          ${product.imagen_url
            ? `<img
                src="${product.imagen_url}"
                alt="${product.nombre}"
                loading="lazy"
                class="w-full h-full object-cover transition-editorial group-hover:scale-[1.02] ${isSold ? 'grayscale opacity-60' : ''}"
              />`
            : `<div class="w-full h-full bg-sage/30 flex items-center justify-center">
                <span class="type-label text-charcoal/20">Sin imagen</span>
              </div>`
          }
            ${isSold
            ? `<div class="absolute inset-0 flex items-center justify-center">
                <span class="type-label text-sm px-4 py-1.5 bg-charcoal/80 text-cream tracking-widest">
                  Vendido
                </span>
              </div>`
            : ''
          }
        </a>

        <!-- Info -->
        <div class="p-4 flex flex-col gap-2">
          <div class="flex items-start justify-between gap-3">
            <a href="/producto?id=${product.id}" class="hover:opacity-80 transition-editorial">
              <h2 class="type-display-sm text-base md:text-lg leading-tight ${isSold ? 'line-through opacity-50' : ''}">
                ${product.nombre}
              </h2>
            </a>
            <span class="type-mono text-sm md:text-base shrink-0 ${isSold ? 'line-through opacity-50' : 'text-forest'}">
              $${priceFormatted}
            </span>
          </div>

          <div class="flex items-center gap-2">
            <span class="type-label text-[0.6rem] px-2.5 py-1 rounded-md bg-sage/40 text-charcoal/70">
              ${product.categoria}
            </span>
            <span class="type-label text-[0.6rem] px-2.5 py-1 rounded-md ${isSold ? 'badge-vendido' : 'badge-disponible shadow-sm'}">
              ${isSold ? 'Vendido' : 'Disponible'}
            </span>
          </div>

          ${!isSold
            ? `<a
                href="${whatsappUrl}"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 flex items-center justify-center gap-2 px-4 py-3 bg-forest rounded-xl text-cream type-label text-xs shadow-md
                       hover:bg-charcoal hover:-translate-y-0.5 transition-editorial"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                Comprar por WhatsApp
              </a>`
            : `<div class="mt-2 flex items-center justify-center gap-2 px-4 py-2.5 bg-charcoal/10 text-charcoal/30 type-label text-xs cursor-not-allowed">
                Artículo vendido
              </div>`
          }
        </div>
      </article>
    `;
  }

  // ── Init ─────────────────────────────────────────────────
  fetchProducts();
</script>

<!-- ═══════════════════════════════════════════════════════
     PAGE-SPECIFIC STYLES
     ═══════════════════════════════════════════════════════ -->
<style is:global>
  /* ── Uniform Product Grid ─────────────────────────────── */
  .catalog-grid-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .catalog-grid-layout {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .catalog-grid-layout {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ── Card ─────────────────────────────────────────────── */
  .catalog-card {
    border: 1px solid color-mix(in srgb, var(--color-charcoal) 8%, transparent);
    background: #ffffff;
    border-radius: 1.25rem;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(28, 32, 29, 0.03), 0 1px 3px rgba(28, 32, 29, 0.02);
  }

  .catalog-card:hover {
    border-color: color-mix(in srgb, var(--color-charcoal) 15%, transparent);
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(28, 32, 29, 0.08), 0 4px 8px rgba(28, 32, 29, 0.04);
  }

  .catalog-card--sold {
    border-color: color-mix(in srgb, var(--color-charcoal) 8%, transparent);
  }

  .catalog-card--sold:hover {
    border-color: color-mix(in srgb, var(--color-charcoal) 20%, transparent);
  }

  .catalog-card__image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-bottom: 1px solid color-mix(in srgb, var(--color-charcoal) 6%, transparent);
  }

  /* ── Filter Buttons ───────────────────────────────────── */
  .filter-btn {
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    border-color: var(--color-charcoal);
  }

  .filter-btn[data-category].bg-forest {
    border-color: var(--color-forest);
  }
  /* ── Pulsing Dot ──────────────────────────────────────── */
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.8); }
  }

  .animate-pulse-dot {
    animation: pulse-dot 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>
